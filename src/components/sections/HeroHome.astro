---
interface GalleryImage {
  src: string;
  alt: string;
  label?: string;
  link?: string;
  description?: string;
}

interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  image?: string;
  /** Background video (muted, looping) with a dark overlay and light text. */
  video?: string;
  /** Still frame shown before the video loads and for reduced-motion users. */
  poster?: string;
  galleryImages?: GalleryImage[];
}

const {
  title,
  eyebrow,
  description,
  ctaText,
  ctaLink,
  secondaryCtaText,
  secondaryCtaLink,
  image,
  video,
  poster,
  galleryImages = [],
} = Astro.props;

const hasVideo = Boolean(video);
---

<section
  class:list={[
    "pb-12 md:pb-20 relative overflow-hidden -mt-16 sm:-mt-24 pt-28 sm:pt-40 flex flex-col justify-center",
    hasVideo ? "hero-video-section min-h-[80vh] isolate" : "md:min-h-0",
  ]}
>
  {
    hasVideo ? (
      <>
        <!-- Background video + overlay (poster sits underneath as a fallback) -->
        {poster && (
          <img
            src={poster}
            alt=""
            class="absolute inset-0 w-full h-full object-cover -z-30"
            fetchpriority="high"
          />
        )}
        <video
          class="hero-video absolute inset-0 w-full h-full object-cover -z-20"
          src={video}
          poster={poster}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        />
        <div class="absolute inset-0 bg-primary-darker/60 -z-10" />
      </>
    ) : (
      <!-- White Background - extends behind navbar -->
      <div class="absolute inset-0 top-[-64px] sm:top-[-96px] bg-neutral -z-10" />
    )
  }

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 md:mb-12 relative">
    <!-- Content -->
    <div class="pb-6 sm:pb-8 md:pb-12">
      <div class="max-w-4xl text-center mx-auto">
        {
          eyebrow && (
            <div
              class:list={[
                "inline-block mb-4 px-4 py-2 backdrop-blur-sm rounded-full border",
                hasVideo ? "bg-neutral/10 border-neutral/30" : "bg-neutral/50 border-primary-light/30",
              ]}
            >
              <span
                class:list={[
                  "text-xs sm:text-sm font-semibold uppercase tracking-wider",
                  hasVideo ? "text-neutral" : "text-primary",
                ]}
              >
                {eyebrow}
              </span>
            </div>
          )
        }

        {
          title && (
            <h1
              class:list={[
                "text-4xl sm:text-5xl md:text-5xl lg:text-6xl font-bold mb-4 sm:mb-6 leading-tight",
                hasVideo ? "text-neutral" : "text-primary-dark",
              ]}
              style={hasVideo ? "color: var(--color-neutral)" : undefined}
            >
              {title}
            </h1>
          )
        }

        {
          description && (
            <p
              class:list={[
                "text-base sm:text-lg md:text-xl mb-8 sm:mb-10 leading-relaxed max-w-2xl mx-auto",
                hasVideo ? "text-neutral/90" : "text-primary-dark/70",
              ]}
            >
              {description}
            </p>
          )
        }

        {
          (ctaText || secondaryCtaText) && (
            <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 justify-center">
              {ctaText && ctaLink && (
                <a
                  href={ctaLink}
                  class:list={[
                    "cta-button inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-4 text-sm sm:text-base font-bold rounded-full leading-tight text-center",
                    hasVideo
                      ? "bg-neutral text-primary-dark hover:bg-neutral-dark"
                      : "bg-primary-dark text-neutral hover:bg-primary-darker",
                  ]}
                >
                  <span>{ctaText}</span>
                  <svg
                    class="w-4 h-4 sm:w-5 sm:h-5 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </a>
              )}
              {secondaryCtaText && secondaryCtaLink && (
                <a
                  href={secondaryCtaLink}
                  class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-4 bg-neutral text-primary text-sm sm:text-base font-bold rounded-full border-2 border-primary-light hover:border-primary hover:bg-neutral-dark transition-all duration-300 shadow-md hover:shadow-lg hover:scale-105 hover:-translate-y-0.5 active:scale-100 active:translate-y-0"
                >
                  {secondaryCtaText}
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>

  <!-- Sliding Image Gallery -->
  {
    galleryImages && galleryImages.length > 0 && (
      <div class="hidden lg:block overflow-hidden relative py-10">
        <div class="absolute left-0 top-0 bottom-0 w-12 sm:w-16 md:w-24 lg:w-32 bg-gradient-to-r from-neutral to-transparent z-30 pointer-events-none" />
        <div class="absolute right-0 top-0 bottom-0 w-12 sm:w-16 md:w-24 lg:w-32 bg-gradient-to-l from-neutral to-transparent z-30 pointer-events-none" />
        <div class="gallery-track">
          {[false, true].map((isCopy) => (
            <div class="gallery-slide" aria-hidden={isCopy ? "true" : undefined}>
              {galleryImages.map((img) => (
                <div class="gallery-item">
                  {img.link ? (
                    <a
                      href={img.link}
                      class="block relative h-48 sm:h-56 md:h-64 rounded-2xl overflow-hidden group shadow-xl hover:shadow-2xl transition-all duration-700 ease-out transform"
                    >
                      <img
                        src={img.src}
                        alt={img.alt}
                        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 z-10 bg-primary-darker/40 group-hover:bg-primary-darker/80 group-hover:backdrop-blur-sm transition-all duration-700 ease-in-out" />
                      <div class="absolute inset-0 z-20 flex flex-col justify-end p-4 text-neutral">
                        {img.label && (
                          <p class="text-base md:text-lg font-bold mb-2 transition-all duration-700 ease-out transform group-hover:translate-y-[-4px]">
                            {img.label}
                          </p>
                        )}
                        {img.description && (
                          <div class="overflow-hidden transition-all duration-700 ease-out max-h-0 group-hover:max-h-48 transform">
                            <p class="text-xs md:text-sm leading-relaxed opacity-0 group-hover:opacity-100 transition-all duration-700 delay-150 ease-out transform translate-y-2 group-hover:translate-y-0">
                              {img.description}
                            </p>
                          </div>
                        )}
                      </div>
                    </a>
                  ) : (
                    <div class="relative h-48 sm:h-56 md:h-64 rounded-2xl overflow-hidden group shadow-xl">
                      <img
                        src={img.src}
                        alt={img.alt}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 z-10 bg-primary-darker/40" />
                      <div class="absolute inset-0 z-20 flex flex-col justify-end p-4 text-neutral">
                        {img.label && (
                          <p class="text-base md:text-lg font-bold">
                            {img.label}
                          </p>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    )
  }
</section>

<style>
  .cta-button {
    transform: scale(1);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), 
                background-color 0.25s ease, 
                box-shadow 0.25s ease,
                border-color 0.25s ease;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: translateZ(0) scale(1);
    transform: translateZ(0) scale(1);
  }

  .cta-button::before {
    display: none !important;
  }

  .cta-button:hover {
    -webkit-transform: translateZ(0) scale(1.05);
    transform: translateZ(0) scale(1.05);
  }

  .cta-button:active {
    -webkit-transform: translateZ(0) scale(1);
    transform: translateZ(0) scale(1);
  }

  /*
   * Seamless marquee: the track holds two identical slides.
   * Every item — including each slide's last — carries the SAME trailing
   * space via `margin-right`, so there is no larger gap at the seam and
   * both slides are exactly equal width. With no slide-level gap/padding,
   * translateX(-50%) lands item-for-item on the duplicate at every
   * breakpoint, and the space at the wrap point matches the space between
   * every other pair of cards.
   */
  .gallery-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: scroll 60s linear infinite;
  }

  .gallery-track:hover {
    animation-play-state: paused;
  }

  .gallery-slide {
    display: flex;
    flex-shrink: 0;
  }

  .gallery-item {
    flex: none;
    width: 200px;
    margin-right: 1rem;
  }

  @media (min-width: 640px) {
    .gallery-item {
      flex: none;
      width: 240px;
      margin-right: 1.25rem;
    }
  }

  @media (min-width: 768px) {
    .gallery-item {
      flex: none;
      width: 260px;
      margin-right: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-item {
      flex: none;
      width: 280px;
      margin-right: 1.5rem;
    }
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* The scroll fade-in shifts a section down while hidden; under a dark video
     hero that gap shows as a white band, so show the next section in place. */
  :global(.hero-video-section + .fade-in-section) {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
    .gallery-track {
      animation: none;
    }
  }
</style>

<script>
  // ClientRouter swaps pages in without a full load, and a swapped-in <video>
  // never fetches its src, doesn't autoplay, and doesn't pick up its `muted`
  // attribute (which browsers need to allow autoplay). Start it explicitly on
  // every page load.
  function playHeroVideo() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll<HTMLVideoElement>(".hero-video").forEach((video) => {
      video.muted = true;
      if (video.readyState === HTMLMediaElement.HAVE_NOTHING) video.load();
      video.play().catch(() => {
        // Autoplay refused (e.g. data saver); the poster image stays visible.
      });
    });
  }

  document.addEventListener("astro:page-load", playHeroVideo);
</script>
