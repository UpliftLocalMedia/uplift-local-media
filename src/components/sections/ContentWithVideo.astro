---
interface Props {
  title: string;
  description: string;
  videoUrl: string;
  /** Still frame shown before the video plays. */
  poster?: string;
  /** Small label under the video (e.g. "Content Example"). */
  caption?: string;
  /** Play muted on a silent loop with no controls instead of a click-to-play player. */
  loop?: boolean;
  eyebrow?: string;
  background?: "white" | "primary" | "primary-dark" | "light";
}

const {
  title,
  description,
  videoUrl,
  poster,
  caption,
  loop = false,
  eyebrow,
  background = "white",
} = Astro.props;

const bgClasses = {
  white: "bg-neutral",
  light: "bg-neutral",
  primary: "bg-primary",
  "primary-dark": "bg-primary",
};

const textColorClasses = {
  white: "text-primary",
  light: "text-primary",
  primary: "text-neutral",
  "primary-dark": "text-neutral",
};

const descriptionColorClasses = {
  white: "text-primary-dark",
  light: "text-primary-dark",
  primary: "text-neutral",
  "primary-dark": "text-neutral",
};
---

<section class={`py-16 md:py-24 ${bgClasses[background]} fade-in-section`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Content Column -->
      <div class="lg:order-1">
        <div class="space-y-6">
          {
            eyebrow && (
              <div
                class={`inline-flex items-center gap-2 px-4 py-2 rounded-full ${background === "primary" || background === "primary-dark" ? "bg-neutral/10 border border-neutral/20" : "bg-primary/5 border border-primary-light/30"}`}
              >
                <span
                  class={`w-2 h-2 rounded-full ${background === "primary" || background === "primary-dark" ? "bg-neutral" : "bg-primary-light"}`}
                />
                <span
                  class={`section-eyebrow ${background === "primary" || background === "primary-dark" ? "text-neutral" : "text-primary"}`}
                >
                  {eyebrow}
                </span>
              </div>
            )
          }

          <h2 class={`section-title ${textColorClasses[background]}`}>
            {title}
          </h2>

          <!-- Accent line -->
          <div
            class={`w-20 h-1 ${background === "primary" || background === "primary-dark" ? "bg-neutral/30" : "bg-primary-light"}`}
          >
          </div>

          <div
            class={`section-description space-y-4 ${descriptionColorClasses[background]}`}
            set:html={description}
          />
        </div>
      </div>

      <!-- Video Column -->
      <div class="lg:order-2">
        <div class="relative group">
          <!-- Decorative background -->
          <div
            class={`absolute -inset-4 rounded-3xl ${background === "primary" || background === "primary-dark" ? "bg-neutral/5" : "bg-primary/5"}`}
          >
          </div>

          <!-- Video container -->
          <div
            class="relative rounded-2xl overflow-hidden shadow-[0_20px_60px_color-mix(in_srgb,var(--color-primary-darker)_30%,transparent)] bg-primary-darker"
          >
            {loop ? (
              <video
                class="loop-video w-full h-auto"
                src={videoUrl}
                poster={poster}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={caption || title}
              />
            ) : (
              <video controls class="w-full h-auto" preload="metadata" poster={poster}>
                <source src={videoUrl} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            )}
          </div>

          {caption && (
            <p
              class={`relative mt-4 text-center text-sm font-semibold uppercase tracking-wider ${background === "primary" || background === "primary-dark" ? "text-neutral/80" : "text-primary"}`}
            >
              {caption}
            </p>
          )}

          <!-- Corner accent -->
          <div
            class={`absolute -bottom-6 -right-6 w-32 h-32 rounded-full ${background === "primary" || background === "primary-dark" ? "bg-neutral/5" : "bg-primary-light/20"} blur-2xl`}
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { playAutoplayVideos } from "~/lib/autoplayVideos";

  document.addEventListener("astro:page-load", () => playAutoplayVideos(".loop-video"));
</script>
