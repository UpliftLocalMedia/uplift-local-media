---
import { Icon } from "astro-icon/components";
import reviewsData from "~/content/settings/reviews.json";

interface Review {
  name: string;
  avatar?: string;
  rating?: number;
  text: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  reviews?: Review[];
}

const {
  eyebrow = "Google Reviews",
  title = "What Our Clients Say",
  description,
  reviews = reviewsData.reviews,
} = Astro.props;

const source = reviewsData.source || "Google";
---

<section class="py-16 md:py-24 bg-neutral-dark relative overflow-hidden fade-in-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      {
        eyebrow && (
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/5 border border-primary-light/30 mb-6">
            <Icon name="tabler:brand-google" class="w-5 h-5 text-primary" />
            <span class="text-sm font-bold uppercase tracking-wider text-primary">{eyebrow}</span>
          </div>
        )
      }
      {title && <h2 class="section-title text-primary mb-4">{title}</h2>}
      {
        description && (
          <p class="section-description text-primary-dark" set:html={description} />
        )
      }
    </div>

    <!-- Reviews Carousel -->
    <div class="reviews-carousel" data-reviews-carousel>
      <div
        class="reviews-track flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2"
        data-reviews-track
        tabindex="0"
        aria-label={`${source} reviews`}
      >
        {
          reviews.map((review) => (
            <figure class="review-card snap-start shrink-0 self-start p-6 bg-neutral rounded-2xl border-2 border-primary-light/20 hover:border-primary-light hover:shadow-lg transition-all duration-300">
              <figcaption class="flex items-center gap-3">
                {review.avatar ? (
                  <img
                    src={review.avatar}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                    class="w-12 h-12 shrink-0 rounded-full object-cover"
                  />
                ) : (
                  <span
                    class="w-12 h-12 shrink-0 rounded-full bg-primary text-neutral text-lg font-bold flex items-center justify-center"
                    aria-hidden="true"
                  >
                    {review.name.charAt(0)}
                  </span>
                )}
                <span class="flex-1 min-w-0 font-bold text-primary-dark leading-snug">{review.name}</span>
                {/* Google "G" mark */}
                <svg class="w-6 h-6 shrink-0" viewBox="0 0 48 48" role="img" aria-label={`Posted on ${source}`}>
                  <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
                  <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                  <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z" />
                  <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
                </svg>
              </figcaption>
              <div class="mt-4 flex items-center gap-1.5">
                <span class="flex gap-0.5 text-amber-400" aria-label={`${review.rating ?? 5} out of 5 stars`}>
                  {Array.from({ length: review.rating ?? 5 }).map(() => (
                    <Icon name="tabler:star-filled" class="w-5 h-5" />
                  ))}
                </span>
                <Icon
                  name="tabler:rosette-discount-check-filled"
                  class="w-5 h-5 text-[#4285F4]"
                  aria-label={`Verified ${source} review`}
                />
              </div>
              <blockquote class="mt-3 text-primary-dark/80 leading-relaxed">
                <p class="review-text line-clamp-5">{review.text}</p>
              </blockquote>
              <button
                type="button"
                class="review-toggle mt-2 text-sm text-primary-dark/50 hover:text-primary-dark transition"
                aria-expanded="false"
              >
                Read more
              </button>
            </figure>
          ))
        }
      </div>

      <!-- Controls -->
      <div class="flex items-center justify-center gap-4 mt-8">
        <button
          type="button"
          class="carousel-btn flex items-center justify-center w-12 h-12 disabled:opacity-40 disabled:pointer-events-none"
          data-reviews-prev
          aria-label="Previous reviews"
        >
          <Icon name="tabler:chevron-left" class="w-5 h-5" />
        </button>
        <button
          type="button"
          class="carousel-btn flex items-center justify-center w-12 h-12 disabled:opacity-40 disabled:pointer-events-none"
          data-reviews-next
          aria-label="Next reviews"
        >
          <Icon name="tabler:chevron-right" class="w-5 h-5" />
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-track {
    scrollbar-width: none;
  }
  .reviews-track::-webkit-scrollbar {
    display: none;
  }
  /* 1 card on mobile, 2 on tablet, 3 on desktop (gap is 1.5rem). */
  .review-card {
    width: 100%;
  }
  @media (min-width: 768px) {
    .review-card {
      width: calc((100% - 1.5rem) / 2);
    }
  }
  @media (min-width: 1024px) {
    .review-card {
      width: calc((100% - 3rem) / 3);
    }
  }
</style>

<script>
  function initReviewCarousels() {
    document.querySelectorAll<HTMLElement>("[data-reviews-carousel]").forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = "true";
      const track = root.querySelector<HTMLElement>("[data-reviews-track]");
      const prev = root.querySelector<HTMLButtonElement>("[data-reviews-prev]");
      const next = root.querySelector<HTMLButtonElement>("[data-reviews-next]");
      if (!track || !prev || !next) return;

      // Read more / Hide toggles; hidden when the review already fits.
      root.querySelectorAll<HTMLButtonElement>(".review-toggle").forEach((btn) => {
        const text = btn.parentElement?.querySelector<HTMLElement>(".review-text");
        if (!text) return;
        if (text.scrollHeight <= text.clientHeight + 1) {
          btn.hidden = true;
          return;
        }
        btn.addEventListener("click", () => {
          const expanded = text.classList.toggle("line-clamp-5") === false;
          btn.setAttribute("aria-expanded", String(expanded));
          btn.textContent = expanded ? "Hide" : "Read more";
        });
      });

      const update = () => {
        const max = track.scrollWidth - track.clientWidth - 1;
        prev.disabled = track.scrollLeft <= 0;
        next.disabled = track.scrollLeft >= max;
      };
      // Scroll one "page" of visible cards at a time.
      prev.addEventListener("click", () => track.scrollBy({ left: -track.clientWidth }));
      next.addEventListener("click", () => track.scrollBy({ left: track.clientWidth }));
      track.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();
    });
  }

  initReviewCarousels();
  document.addEventListener("astro:page-load", initReviewCarousels);
</script>
