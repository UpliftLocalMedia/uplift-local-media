---
import PageLayout from "~/layouts/PageLayout.astro";
import SectionRenderer from "~/components/sections/SectionRenderer.astro";
import PopupModal from "~/components/ui/PopupModal.astro";
import FloatingCTAButton from "~/components/ui/FloatingCTAButton.astro";

// Get homepage content from JSON data
import homeDataRaw from "~/data/pages/home.json";
import popupDataRaw from "~/content/settings/popup.json";
import { localizeData } from "~/config/site";
import { buildPageMeta } from "~/lib/pageMeta";

const homeData = localizeData(homeDataRaw);
const { sections } = homeData;
const { metadata, extraSchemas } = buildPageMeta(homeData);

// Consultation popup + its floating trigger button, driven by popup.json.
// `delay` in the JSON is in seconds; the modal expects milliseconds.
const popup = localizeData(popupDataRaw);
---

<PageLayout metadata={metadata} extraSchemas={extraSchemas}>
  <SectionRenderer sections={sections} />

  {
    popup.enabled && (
      <>
        {/* Floating CTA Button */}
        <FloatingCTAButton id="free-scan-button" text={popup.buttonText} />

        {/* Popup Modal */}
        <PopupModal
          triggerId="free-scan-button"
          enabled={popup.enabled}
          title={popup.title}
          description={popup.description}
          ctaText={popup.buttonText}
          ctaLink={popup.buttonHref}
          image={popup.image || undefined}
          imageAlt={popup.imageAlt}
          badge={popup.badge}
          headline={popup.headline}
          benefits={popup.benefits}
          trustIndicators={popup.trustIndicators}
          dismissText={popup.dismissText}
          delay={(popup.delay ?? 0) * 1000}
          showOnce={true}
        />
      </>
    )
  }
</PageLayout>
