---
// Case Studies GRID page (under About Us). Thin route: fetch this client's
// published studies + categories from the shared read API, read ?category= for
// the active filter, and drop the CaseStudiesGrid section into the PageLayout.
// Breadcrumbs (Home → About Us → Case Studies) are auto-generated by BaseLayout
// from the URL path.
import PageLayout from "~/layouts/PageLayout.astro";
import CaseStudiesGrid from "~/components/sections/CaseStudiesGrid.astro";
import MapSection from "~/components/sections/MapSection.astro";
import { venueLocations } from "~/lib/venues";
import FAQs from "~/components/sections/FAQs.astro";
import { listCaseStudies, getCategories } from "~/lib/case-studies";

const basePath = "/about-us/case-studies";


// Shared FAQ content for the case studies pages.
const caseStudyFaqs = [
  {
    question: "How long does it take to see results?",
    answer:
      "Most campaigns begin showing measurable movement within the first 30 to 60 days. The strongest gains tend to compound over the following months as data accumulates and targeting is refined.",
  },
  {
    question: "Can these results be replicated for my business?",
    answer:
      "Yes. While every business is different, the strategy behind our work is repeatable. We combine audience research, precise targeting, and continuous optimization, then tailor it to each client's goals and market.",
  },
  {
    question: "How do we get started?",
    answer:
      "Reach out for a free consultation. We'll review your current marketing, identify the biggest opportunities, and put together a tailored plan with no obligation.",
  },
];

// Server-rendered so admin edits appear immediately (no rebuild). Cached at the
// CDN edge for 60s to keep it fast. The category filter is applied client-side.
export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60, stale-while-revalidate=300");

const [categories, studies] = await Promise.all([
  getCategories(),
  listCaseStudies(),
]);

const metadata = {
  title: "Case Studies — Real Results for Local Businesses",
  description:
    "See how local businesses grew with our marketing solutions. Real campaigns, real numbers, real results.",
};
---

<PageLayout metadata={metadata}>
  <CaseStudiesGrid
    studies={studies}
    categories={categories}
    basePath={basePath}
    eyebrow="Proven Results"
    title="Case Studies"
    description="Real results from real local businesses."
  />

  <MapSection
    eyebrow="Where We Work"
    title="Our Coverage Area"
    description="Explore the locations where we help local businesses grow."
    locations={venueLocations}
    background="gradient"
  />

  <FAQs
    title="Frequently Asked Questions"
    faqs={caseStudyFaqs}
    background="white"
  />
</PageLayout>
